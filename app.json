{
  "expo": {
    "name": "yumQuick",
    "slug": "yumQuick",
    "scheme": "yumquick",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    // "splash": {
    //   "image": "./assets/yumQuick-splash.png",
    //   "resizeMode": "contain",
    //   "backgroundColor": "#F5CB58"
    // },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5CB58"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5CB58",
          "image": "./assets/yumQuick-splash.png",
          "resizeMode": "contain",
          "imageWidth": 220,
          "dark": {
            "backgroundColor": "#F5CB58"
          }
        }
      ]
    ]
  }
}
