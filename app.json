{
  "expo": {
    "name": "yumQuick",
    "slug": "yumQuick",
    "scheme": "yumquick",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.yumquick.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5CB58"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5CB58",
          "image": "./assets/yumQuick-splash.png",
          "resizeMode": "contain",
          "imageWidth": 220,
          "dark": {
            "backgroundColor": "#F5CB58"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "57611db2-c3d1-4214-b35a-7600e868b339"
      }
    },
    "owner": "sule_suleman"
  }
}
