# Base URL for the JSON Server fake backend (see `npm run mock-api`).
# Must be your machine's LAN IP (not localhost) so physical devices/emulators
# on the same Wi-Fi can reach it. Find yours with `ipconfig` (Windows) or
# `ifconfig`/`ip addr` (macOS/Linux).
EXPO_PUBLIC_API_URL=http://192.168.18.20:3001
